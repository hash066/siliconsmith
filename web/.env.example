# Copy to .env.local and fill in. Never commit real values. Server-side only: none of these are exposed to the browser.
# The Agent panel's /api/agent route stays in its "not connected" state until NEBIUS_API_KEY is set.
NEBIUS_API_KEY=
# Token Factory OpenAI-compatible endpoint (default https://api.tokenfactory.nebius.com/v1)
TOKEN_FACTORY_BASE_URL=
# Exact model ids from the Token Factory console (defaults are the public Nemotron 3 ids)
SS_MODEL_NANO=
SS_MODEL_SUPER=
SS_MODEL_ULTRA=
# Demo credits (USD). Per visitor per UTC day: kept in a signed httpOnly cookie, so it is exact on every serverless instance.
# The key that signs the cookie is derived from NEBIUS_API_KEY (SHA-256 of 'hw-credits:' + key): no extra secret.
AGENT_VISITOR_USD=0.50
# The shared pool is a hard stop. It is best effort PER SERVER INSTANCE (in memory) until a durable store is configured below.
AGENT_POOL_USD=25
# Backstop per client IP per day (default 3x the visitor allowance)
AGENT_IP_USD=
# Durable pool and IP ledger: set either pair (Vercel KV / Upstash Redis REST). Without them the pool is per instance and the API says so.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Completion tokens per agent turn
AGENT_TURN_MAX_TOKENS=
