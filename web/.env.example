# Copy to .env.local and fill in. Never commit real values. Server-side only: none of these are exposed to the browser.
# The Agent panel's /api/agent route stays in its "not connected" state until NEBIUS_API_KEY is set.
NEBIUS_API_KEY=
# Token Factory OpenAI-compatible endpoint (default https://api.tokenfactory.nebius.com/v1)
TOKEN_FACTORY_BASE_URL=
# Exact model ids from the Token Factory console (defaults are the public Nemotron 3 ids)
SS_MODEL_NANO=
SS_MODEL_SUPER=
SS_MODEL_ULTRA=
# Agent limits (in memory, per server instance): completion tokens per turn, turns per visitor and in total per day
AGENT_TURN_MAX_TOKENS=
AGENT_VISITOR_DAILY_TURNS=
AGENT_GLOBAL_DAILY_TURNS=
