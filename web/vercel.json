{
  "functions": {
    "api/board.py": { "maxDuration": 10, "includeFiles": "api/_vendor/**", "excludeFiles": "{**/tests/**,**/__pycache__/**,**/*.pyc}" },
    "api/matter.py": { "maxDuration": 30, "memory": 1024, "includeFiles": "api/_vendor/**", "excludeFiles": "{**/tests/**,**/__pycache__/**,**/*.pyc}" }
  },
  "rewrites": [
    { "source": "/api/board/:route*", "destination": "/api/board?route=:route*" },
    { "source": "/api/matter/:route*", "destination": "/api/matter?route=:route*" }
  ]
}
