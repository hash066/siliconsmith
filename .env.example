# Copy to .env.local and fill in. Never commit real values.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
# Token Factory OpenAI-compatible endpoint
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Exact model IDs from your Token Factory console
SS_MODEL_NANO=
SS_MODEL_SUPER=
SS_MODEL_ULTRA=
# Sandbox backend: contree | nebius-jobs | local
SS_BACKEND=local
SS_MAX_CONCURRENCY=50
# Hard spend cap per run (USD) and per day for the public demo
SS_RUN_BUDGET_USD=4
SS_DAILY_BUDGET_USD=3
